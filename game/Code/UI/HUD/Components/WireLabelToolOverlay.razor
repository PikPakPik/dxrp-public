@namespace Dxura.RP.Game.UI
@using Dxura.RP.Game.Tools
@using Dxura.RP.Game.Wire
@inherits Panel

<root class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2" style="top: 55%; z-index: 1000;">
	@if (!IsLabelerEquipped || WireLabelTool == null || HoveredWireComponent == null) return;

	<div class="flex flex-col items-center gap-2">
		<div class="bg-primary-95 p-1 rounded">
			<span class="text-base text-accent font-semibold">@HoveredWireComponent.Name</span>
		</div>

		<div class="flex flex-col items-center rounded bg-primary-75 p-2 min-w-40 gap-1">
			<span class="text-white text-bold text-sm uppercase tracking-wide">@Language.GetPhrase("tool.wire.labeler.current")</span>
			@if (CurrentLabel is { } label)
			{
				<span class="text-accent text-sm text-center">@label</span>
			}
			else
			{
				<span class="text-gray-400 text-sm">@Language.GetPhrase("tool.wire.labeler.none")</span>
			}
		</div>

		@if (!string.IsNullOrWhiteSpace(WireLabelTool.Label))
		{
			<span class="text-white text-sm text-center">@Language.GetPhrase("tool.wire.labeler.pending"): @WireLabelTool.Label</span>
		}
	</div>
</root>

@code
{
	private bool IsLabelerEquipped => Player.Local.IsValid() && Player.Local.CurrentEquipment?.Identifier == "tool" && BaseTool.CurrentTool is WireLabelTool;
	private WireLabelTool? WireLabelTool => BaseTool.CurrentTool as WireLabelTool;
	private IWireComponent? HoveredWireComponent => WireLabelTool?.HoveredWireComponent;
	private string? CurrentLabel => HoveredWireComponent == null ? null : WireLabelHelper.GetLabel( HoveredWireComponent );

	protected override int BuildHash()
	{
		if ( !IsLabelerEquipped )
		{
			return 0;
		}

		return HashCode.Combine(
			IsLabelerEquipped,
			WireLabelTool?.HoveredWireComponent?.GetHashCode() ?? 0,
			WireLabelTool?.Label,
			CurrentLabel,
			HoveredWireComponent?.Name
		);
	}
}
