@namespace Dxura.RP.Game.UI
@inherits Panel
@attribute [StyleSheet]

<root>
	@if (!Player.Local.IsValid())
		return;

	<div class="flex gap-3">
		@foreach(var hint in InputHints())
		{
			<div class="flex gap-2 items-center justify-center bg-primary-75 pr-1 py-0 rounded">
				<InputHint Action="@hint.Action" class="small" Size="@InputGlyphSize.Small"/>
				<label class="text-sm text-bold">
					@hint.Label
				</label>
			</div>
		}
	</div>
</root>

@code
{
	private IEnumerable<(string Action, string Label)> InputHints()
	{
		if ( !Player.Local.IsValid() || !Player.Local.CurrentEquipment.IsValid() )
			return [];

		var provider = Player.Local.CurrentEquipment.Components.Get<IInputHints>( FindMode.EverythingInSelfAndDescendants );
		if ( provider is null )
			return [];

		return provider.GetInputHints().Select( h => (h.Action, GetText( h.Label )) );
	}

	protected override int BuildHash()
	{
		if ( !Player.Local.IsValid() ) return 0;

		var equipment = Player.Local.CurrentEquipment;
		if ( !equipment.IsValid() ) return 0;

		var provider = equipment.Components.Get<IInputHints>( FindMode.EverythingInSelfAndDescendants );
		return HashCode.Combine(
			Player.Local.GetHashCode(),
			equipment.GetHashCode(),
			provider?.GetInputHintsHash() ?? 0
		);
	}

	private static string GetText( string? text )
	{
		if ( string.IsNullOrWhiteSpace( text ) ) return string.Empty;
		return text.StartsWith( '#' ) ? Language.GetPhrase( text[1..] ) : text;
	}
}
