@namespace Dxura.RP.Game.UI
@using Sandbox.Services
@using Dxura.RP.Shared
@inherits Panel

@attribute [StyleSheet]

<root>
	@{
		var visibleJobs = GetVisibleJobs().ToList();
		EnsureSelectedJob( visibleJobs );

		var groupedJobs = visibleJobs
			.GroupBy( x => x.GameModeJobGroupId )
			.Select( g => new
			{
				Group = GameModeJobs.FindGroupById( g.Key ),
				GroupId = g.Key,
				Jobs = g.ToList()
			} )
			.OrderBy( x => x.Group?.Name ?? "zzzz" )
			.ToList();
	}

	<div class="job-menu">
		<div class="job-list-panel">
			<div class="job-list-scroll">
				@foreach ( var groupEntry in groupedJobs )
				{
					var group = groupEntry.Group;
					var groupJobs = groupEntry.Jobs;
					if ( groupJobs.Count == 0 ) continue;

					var isCollapsed = IsGroupCollapsed( groupEntry.GroupId );

					<div class="job-group @( isCollapsed ? "collapsed" : "" )">
						<div class="job-group-title"
						     style="background-color: @(group?.Color.Hex() ?? "#4B5563")"
						     onclick="@( () => ToggleGroup( groupEntry.GroupId ) )">
							<i class="material-icons group-toggle-icon">@( isCollapsed ? "expand_less" : "expand_more" )</i>
							@if ( group != null )
							{
								<span>@group.DisplayName()</span>
							}
							else
							{
								<span>Ungrouped</span>
							}
							<span class="job-group-count">@groupJobs.Count</span>
						</div>

						@if ( !isCollapsed )
						{
							<div class="job-list-grid">
								@foreach ( var job in groupJobs )
								{
									var currentPlayers = GameUtils.GetPlayersByJob( job ).Count();
									var isFull = job.MaxCount > 0 && currentPlayers >= job.MaxCount;
									var isCurrentJob = Player.Local.Job == job;
									var isSelected = _selectedJob == job;
									var loadout = SelectedJobPane.GetDisplayLoadout( job ).ToList();
									var visibleLoadout = loadout.Take( MaxCardLoadoutIcons ).ToList();
									var hiddenLoadoutCount = loadout.Count - visibleLoadout.Count;

									<div class="job-list-item @( isSelected ? "selected" : "" ) @( isCurrentJob ? "current" : "" )"
									     onclick="@( () => SelectJobPreview( job ) )">
										<div class="job-list-header">
											<div class="job-list-name" style="color: @job.Color.Hex()">@job.DisplayName()</div>
											@if ( isCurrentJob )
											{
												<div class="current-tag">#tabmenu.jobs.current</div>
											}
										</div>
										<div class="job-list-meta">
											<span class="salary">
												<i class="material-icons">payments</i>
												<span>$@(job.Salary.ToString("N0"))</span>
											</span>
											<span class="player-count @(isFull ? "full" : "")">
												<i class="material-icons">group</i>
												<span>@currentPlayers/@( job.MaxCount == 0 ? "∞" : job.MaxCount.ToString() )</span>
											</span>
											@if ( job.VoteRequired && !IgnoreJobRequirements )
											{
												<span class="vote-badge">
													<i class="material-icons">how_to_vote</i>
												</span>
											}
										</div>
										@if ( !string.IsNullOrWhiteSpace( job.DisplayDescription() ) )
										{
											<div class="job-list-description">@job.DisplayDescription()</div>
										}
										@if ( loadout.Count > 0 )
										{
											<div class="job-list-loadout">
												@foreach ( var equipment in visibleLoadout )
												{
													@if ( !string.IsNullOrEmpty( equipment.DisplayIcon() ) )
													{
														<div class="loadout-icon" style="background-image:url(@equipment.DisplayIcon());" tooltip="@equipment.DisplayName()"></div>
													}
													else
													{
														<div class="loadout-icon loadout-icon-fallback" tooltip="@equipment.DisplayName()">
															<i class="material-icons">inventory_2</i>
														</div>
													}
												}
												@if ( hiddenLoadoutCount > 0 )
												{
													<div class="loadout-more">+@hiddenLoadoutCount</div>
												}
											</div>
										}
									</div>
								}
							</div>
						}
					</div>
				}
			</div>
		</div>

		<div class="job-detail-panel">
			@if ( _selectedJob != null )
			{
				<SelectedJobPane Job="@_selectedJob"
				                 OnSelect="@ConfirmJobSelection"/>
			}
			else
			{
				<div class="job-detail-empty">
					<i class="material-icons">work</i>
					<span>#tabmenu.jobs.select</span>
				</div>
			}
		</div>
	</div>
</root>

@code
{
	const int MaxCardLoadoutIcons = 10;

	GameModeJobDto? _selectedJob;
	HashSet<Guid> _collapsedGroupIds = [];

	bool IgnoreJobRequirements => GameManager.Instance.IsValid() && GameManager.Instance.IgnoreJobRequirements;

	protected override int BuildHash()
	{
		var collapsedHash = 0;
		foreach ( var groupId in _collapsedGroupIds )
		{
			collapsedHash = HashCode.Combine( collapsedHash, groupId );
		}

		return HashCode.Combine( GameModeJobs.All, (int)(Player.Local.PlayTime / 60f), Player.Local.Job, IgnoreJobRequirements, _selectedJob?.Id, collapsedHash, Time.Delta );
	}

	private IEnumerable<GameModeJobDto> GetVisibleJobs()
	{
		return GameModeJobs.All
			.Where( x => x.Selectable || x == Player.Local.Job )
			.Where( job =>
			{
				var prerequisiteJobs = GameModeJobs.GetPrerequisiteJobs( job );
				return prerequisiteJobs.Length == 0 ||
				       prerequisiteJobs.Contains( Player.Local.Job ) ||
				       job == Player.Local.Job;
			} )
			.OrderBy( x => x.GetGroup()?.Name ?? "zzzz" )
			.ThenBy( x => x.DisplayName() );
	}

	private void EnsureSelectedJob( List<GameModeJobDto> visibleJobs )
	{
		if ( _selectedJob != null && visibleJobs.Contains( _selectedJob ) )
		{
			return;
		}

		_selectedJob = visibleJobs.FirstOrDefault( x => x == Player.Local.Job ) ?? visibleJobs.FirstOrDefault();
	}

	private static Guid GetGroupKey( Guid? groupId ) => groupId ?? Guid.Empty;

	private bool IsGroupCollapsed( Guid? groupId ) => _collapsedGroupIds.Contains( GetGroupKey( groupId ) );

	private void ToggleGroup( Guid? groupId )
	{
		Sound.Play( "pop" );

		var key = GetGroupKey( groupId );
		if ( !_collapsedGroupIds.Add( key ) )
		{
			_collapsedGroupIds.Remove( key );
		}
	}

	private void SelectJobPreview( GameModeJobDto job )
	{
		Sound.Play( "pop" );
		_selectedJob = job;
	}

	private void ConfirmJobSelection( GameModeJobDto job )
	{
		Game.Chat.Current.ExecuteCommandHost( "job", job.Id.ToString() );
		TabMenu.RequestCloseMenu();
	}
}
