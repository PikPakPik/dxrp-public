@namespace Dxura.RP.Game.UI
@using Sandbox.Services
@using Sandbox.UI
@using Dxura.RP.Shared
@inherits Panel

@attribute [StyleSheet]

<root>
	@{
		var visibleJobs = GetVisibleJobs().ToList();
		var effectiveSelected = GetEffectiveSelected( visibleJobs );
		var playersByJobId = BuildPlayersByJobMap();

		var groupedJobs = visibleJobs
			.GroupBy( x => x.GameModeJobGroupId )
			.Select( g => new
			{
				Group = GameModeJobs.FindGroupById( g.Key ),
				GroupId = g.Key,
				Jobs = g.ToList()
			} )
			.OrderBy( x => x.Group?.Name ?? "zzzz" )
			.ToList();
	}

	<div class="job-menu">
		<div class="job-list-panel">
			<div class="job-search-bar">
				<i class="material-icons text-gray-400 text-sm">search</i>
				<TabMenuTextEntry
					@ref="_searchTextEntry"
					class="job-search-input"
					placeholder="#tabmenu.jobs.search_placeholder"
					Value:bind="@_searchQuery"/>
				@if ( !string.IsNullOrEmpty( _searchQuery ) )
				{
					<div class="job-search-clear cursor-pointer" onclick="@( () => ClearSearch() )">
						<i class="material-icons text-gray-400 text-sm">close</i>
					</div>
				}
			</div>
			<div class="job-list-scroll">
				@foreach ( var groupEntry in groupedJobs )
				{
					var group = groupEntry.Group;
					var groupJobs = groupEntry.Jobs;
					if ( groupJobs.Count == 0 ) continue;

					var isCollapsed = IsGroupCollapsed( groupEntry.GroupId );
					var groupColor = group?.Color ?? 0x4B5563;

					<div class="job-group @( isCollapsed ? "collapsed" : "" )">
						<div class="job-group-title"
						     style="background-color: @groupColor.ToColor().WithAlpha( 0.45f ).Hex"
						     onclick="@( () => ToggleGroup( groupEntry.GroupId ) )">
							<i class="material-icons group-toggle-icon">@( isCollapsed ? "expand_less" : "expand_more" )</i>
							@if ( group != null )
							{
								<span>@group.DisplayName()</span>
							}
							else
							{
								<span>Ungrouped</span>
							}
							<span class="job-group-count">@groupJobs.Count</span>
						</div>

						@if ( !isCollapsed )
						{
							<div class="job-list">
								@foreach ( var job in groupJobs )
								{
									var jobPlayers = playersByJobId.GetValueOrDefault( job.Id ) ?? EmptyJobPlayers;
									var currentPlayers = jobPlayers.Count;
									var isFull = job.MaxCount > 0 && currentPlayers >= job.MaxCount;
									var isCurrentJob = Player.Local.Job.IsSameJob( job );
									var isSelected = effectiveSelected == job;

									<div class="job-card @( isSelected ? "selected" : "" ) @( isCurrentJob ? "current" : "" )"
									     onclick="@( () => SelectJobPreview( job ) )">
										<div class="job-card-players">
											<JobCardPlayerModel Job="@job"/>
										</div>
										<div class="job-card-body">
											<div class="job-card-info">
												<span class="job-card-name">@job.DisplayName()</span>
											</div>
											<div class="job-card-slots">
												<JobSlotRing CurrentPlayers="@currentPlayers"
												             MaxCount="@job.MaxCount"
												             IsFull="@isFull"/>
											</div>
										</div>
									</div>
								}
							</div>
						}
					</div>
				}
			</div>
		</div>

		<div class="job-detail-panel">
			@if ( effectiveSelected != null )
			{
				<SelectedJobPane Job="@effectiveSelected"
				                 OnSelect="@ConfirmJobSelection"/>
			}
			else
			{
				<div class="job-detail-empty">
					<i class="material-icons">work</i>
					<span>#tabmenu.jobs.select</span>
				</div>
			}
		</div>
	</div>
</root>

@code
{
	static readonly List<Player> EmptyJobPlayers = [];

	GameModeJobDto? _selectedJob;
	HashSet<Guid> _collapsedGroupIds = TabMenuSectionPreferences.LoadCollapsedJobGroups();

	TextEntry? _searchTextEntry;
	string _searchQuery = string.Empty;

	bool IgnoreJobRequirements => GameManager.Instance.IsValid() && GameManager.Instance.IgnoreJobRequirements;

	public override void Tick()
	{
		base.Tick();
		ThumbnailCache.ProcessPortraitQueue( 2 );
	}

	protected override int BuildHash()
	{
		var collapsedHash = 0;
		foreach ( var groupId in _collapsedGroupIds )
		{
			collapsedHash = HashCode.Combine( collapsedHash, groupId );
		}

		return HashCode.Combine( GameModeJobs.All, (int)(Player.Local.PlayTime / 60f), Player.Local.Job, IgnoreJobRequirements, _selectedJob?.Id, collapsedHash, BuildJobOccupancyHash(), _searchQuery );
	}

	private static int BuildJobOccupancyHash()
	{
		var hash = 0;

		foreach ( var player in GameUtils.Players )
		{
			if ( !player.IsValid() || !player.Job.IsValid() )
			{
				continue;
			}

			hash = HashCode.Combine( hash, player.SteamId, player.Job.Id );
		}

		return hash;
	}

	private static Dictionary<Guid, List<Player>> BuildPlayersByJobMap()
	{
		var map = new Dictionary<Guid, List<Player>>();

		foreach ( var player in GameUtils.Players )
		{
			if ( !player.IsValid() || !player.Job.IsValid() )
			{
				continue;
			}

			if ( !map.TryGetValue( player.Job.Id, out var players ) )
			{
				players = [];
				map[player.Job.Id] = players;
			}

			players.Add( player );
		}

		return map;
	}

	private IEnumerable<GameModeJobDto> GetVisibleJobs()
	{
		return GameModeJobs.All
			.Where( x => x.Selectable || x.IsSameJob( Player.Local.Job ) )
			.Where( x => x.IsSameJob( Player.Local.Job ) || IgnoreJobRequirements || !HasUnmetPrerequisite( x ) )
			.Where( x => string.IsNullOrEmpty( _searchQuery ) || x.DisplayName().Contains( _searchQuery, StringComparison.OrdinalIgnoreCase ) )
			.OrderBy( x => x.GetGroup()?.Name ?? "zzzz" )
			.ThenBy( x => x.DisplayName() );
	}

	private static bool HasUnmetPrerequisite( GameModeJobDto job )
	{
		var prerequisiteJobs = GameModeJobs.GetPrerequisiteJobs( job );
		return prerequisiteJobs.Length > 0 && !prerequisiteJobs.Any( p => p.Id == Player.Local.Job?.Id );
	}

	private GameModeJobDto? GetEffectiveSelected( List<GameModeJobDto> visibleJobs )
	{
		if ( _selectedJob != null && visibleJobs.Contains( _selectedJob ) )
			return _selectedJob;

		return visibleJobs.FirstOrDefault( x => x.IsSameJob( Player.Local.Job ) ) ?? visibleJobs.FirstOrDefault();
	}

	private static Guid GetGroupKey( Guid? groupId ) => groupId ?? Guid.Empty;

	private bool IsGroupCollapsed( Guid? groupId ) => string.IsNullOrEmpty( _searchQuery ) && _collapsedGroupIds.Contains( GetGroupKey( groupId ) );

	private void ToggleGroup( Guid? groupId )
	{
		Sound.Play( "pop" );

		var key = GetGroupKey( groupId );
		if ( !_collapsedGroupIds.Add( key ) )
		{
			_collapsedGroupIds.Remove( key );
		}

		TabMenuSectionPreferences.SaveCollapsedJobGroups( _collapsedGroupIds );
	}

	private void ClearSearch()
	{
		_searchQuery = string.Empty;
		if ( _searchTextEntry != null )
			_searchTextEntry.Text = string.Empty;
	}

	private void SelectJobPreview( GameModeJobDto job )
	{
		Sound.Play( "pop" );
		_selectedJob = job;
	}

	private void ConfirmJobSelection( GameModeJobDto job )
	{
		Game.Chat.Current.ExecuteCommandHost( "job", job.Id.ToString() );
		TabMenu.RequestCloseMenu();
	}
}
